+/* Leyla: tell the converter what the input is (its transfer, PQ or HLG; its
+ * primaries; its range; its HDR10 mastering and content light levels) and
+ * how to map it, from the first frame, before Init. Without them it had no
+ * HDR input to map from. The AMF enums are ISO/IEC 23001-8's, as ffmpeg's. */
+static int vpp_amf_set_input_color(AVFilterContext *avctx, const AVFrame *in)
+{
+    AMFFilterContext *ctx = avctx->priv;
+    AMF_RESULT res;
+
+    if (in->color_trc != AVCOL_TRC_UNSPECIFIED) {
+        AMF_ASSIGN_PROPERTY_INT64(res, ctx->component, AMF_VIDEO_CONVERTER_INPUT_TRANSFER_CHARACTERISTIC, (amf_int64)in->color_trc);
+        AMF_RETURN_IF_FALSE(avctx, res == AMF_OK, AVERROR_UNKNOWN, "AMFConverter-SetProperty(InputTransferChar) failed with error %d\n", res);
+    }
+    if (in->color_primaries != AVCOL_PRI_UNSPECIFIED) {
+        AMF_ASSIGN_PROPERTY_INT64(res, ctx->component, AMF_VIDEO_CONVERTER_INPUT_COLOR_PRIMARIES, (amf_int64)in->color_primaries);
+        AMF_RETURN_IF_FALSE(avctx, res == AMF_OK, AVERROR_UNKNOWN, "AMFConverter-SetProperty(InputColorPrimaries) failed with error %d\n", res);
+    }
+    if (in->color_range == AVCOL_RANGE_MPEG || in->color_range == AVCOL_RANGE_JPEG) {
+        AMF_ASSIGN_PROPERTY_INT64(res, ctx->component, AMF_VIDEO_CONVERTER_INPUT_COLOR_RANGE,
+                                  in->color_range == AVCOL_RANGE_JPEG ? AMF_COLOR_RANGE_FULL : AMF_COLOR_RANGE_STUDIO);
+        AMF_RETURN_IF_FALSE(avctx, res == AMF_OK, AVERROR_UNKNOWN, "AMFConverter-SetProperty(InputColorRange) failed with error %d\n", res);
+    }
+    if (ctx->tonemap != AMF_VIDEO_CONVERTER_TONEMAPPING_UNDEFINED) {
+        AMF_ASSIGN_PROPERTY_INT64(res, ctx->component, AMF_VIDEO_CONVERTER_INPUT_TONEMAPPING, ctx->tonemap);
+        AMF_RETURN_IF_FALSE(avctx, res == AMF_OK, AVERROR_UNKNOWN, "AMFConverter-SetProperty(InputTonemapping) failed with error %d\n", res);
+    }
+    if (av_frame_get_side_data(in, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA) ||
+        av_frame_get_side_data(in, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL)) {
+        AMFBuffer *buffer = NULL;
+        res = ctx->amf_device_ctx->context->pVtbl->AllocBuffer(ctx->amf_device_ctx->context, AMF_MEMORY_HOST,
+                                                              sizeof(AMFHDRMetadata), &buffer);
+        AMF_RETURN_IF_FALSE(avctx, res == AMF_OK, AVERROR(ENOMEM), "AllocBuffer() failed with error %d\n", res);
+        vpp_amf_hdr_metadata(in, (AMFHDRMetadata *)buffer->pVtbl->GetNative(buffer));
+        AMF_ASSIGN_PROPERTY_INTERFACE(res, ctx->component, AMF_VIDEO_CONVERTER_INPUT_HDR_METADATA, buffer);
+        buffer->pVtbl->Release(buffer);
+        AMF_RETURN_IF_FALSE(avctx, res == AMF_OK, AVERROR_UNKNOWN, "AMFConverter-SetProperty(InputHdrMetadata) failed with error %d\n", res);
+    }
+    return 0;
+}
