+/* Leyla: the input's HDR10 metadata in AMF's units (as amfenc.c reads it). */
+static void vpp_amf_hdr_metadata(const AVFrame *frame, AMFHDRMetadata *meta)
+{
+    const AVFrameSideData *sd_display = av_frame_get_side_data(frame, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+    const AVFrameSideData *sd_light = av_frame_get_side_data(frame, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
+
+    memset(meta, 0, sizeof(*meta));
+    if (sd_display) {
+        const AVMasteringDisplayMetadata *display = (const AVMasteringDisplayMetadata *)sd_display->data;
+        if (display->has_luminance) {
+            meta->maxMasteringLuminance = (amf_uint32)(10000 * av_q2d(display->max_luminance));
+            meta->minMasteringLuminance = FFMIN((amf_uint32)(10000 * av_q2d(display->min_luminance)),
+                                                meta->maxMasteringLuminance);
+        }
+        if (display->has_primaries) {
+            const unsigned den = 50000;
+#define CHROMA(q) FFMIN((amf_uint16)(den * av_q2d(q)), den)
+            meta->redPrimary[0]   = CHROMA(display->display_primaries[0][0]);
+            meta->redPrimary[1]   = CHROMA(display->display_primaries[0][1]);
+            meta->greenPrimary[0] = CHROMA(display->display_primaries[1][0]);
+            meta->greenPrimary[1] = CHROMA(display->display_primaries[1][1]);
+            meta->bluePrimary[0]  = CHROMA(display->display_primaries[2][0]);
+            meta->bluePrimary[1]  = CHROMA(display->display_primaries[2][1]);
+            meta->whitePoint[0]   = CHROMA(display->white_point[0]);
+            meta->whitePoint[1]   = CHROMA(display->white_point[1]);
+#undef CHROMA
+        }
+    }
+    if (sd_light) {
+        const AVContentLightMetadata *light = (const AVContentLightMetadata *)sd_light->data;
+        meta->maxContentLightLevel = (amf_uint16)FFMIN(light->MaxCLL, 65535);
+        meta->maxFrameAverageLightLevel = (amf_uint16)FFMIN(light->MaxFALL, 65535);
+    }
+}
