+/* Leyla: one property of the converter's colour negotiation, the input's
+ * free and the output's what the options make it (or the input's own). */
+static int vpp_amf_negotiate(AVFilterFormats **in, AVFilterFormats **out,
+                             AVFilterFormats *all, int fixed)
+{
+    int err;
+    if ((err = ff_formats_ref(all, in)) < 0)
+        return err;
+    if (fixed < 0)
+        return ff_formats_ref(all, out); // shared: output is the input's
+    return ff_formats_ref(ff_make_formats_list_singleton(fixed), out);
+}
