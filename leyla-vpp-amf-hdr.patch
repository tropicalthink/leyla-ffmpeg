+/* Leyla: the colour space and range the options make the output, or
+ * unspecified where they leave it as the input's. */
+static int vpp_amf_output_color_space(const AMFFilterContext *ctx)
+{
+    switch (ctx->color_profile) {
+    case AMF_VIDEO_CONVERTER_COLOR_PROFILE_601:  return AVCOL_SPC_SMPTE170M;
+    case AMF_VIDEO_CONVERTER_COLOR_PROFILE_709:  return AVCOL_SPC_BT709;
+    case AMF_VIDEO_CONVERTER_COLOR_PROFILE_2020: return AVCOL_SPC_BT2020_NCL;
+    default:                                     return AVCOL_SPC_UNSPECIFIED;
+    }
+}
+
+static int vpp_amf_output_color_range(const AMFFilterContext *ctx)
+{
+    switch (ctx->color_range) {
+    case AMF_COLOR_RANGE_STUDIO: return AVCOL_RANGE_MPEG;
+    case AMF_COLOR_RANGE_FULL:   return AVCOL_RANGE_JPEG;
+    default:                     return AVCOL_RANGE_UNSPECIFIED;
+    }
+}
