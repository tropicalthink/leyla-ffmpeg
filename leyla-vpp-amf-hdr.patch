+/* Leyla: Init on the first frame (its colour set first); a tone-mapped
+ * picture leaves its source's HDR10 descriptions behind. */
+static int vpp_amf_filter_frame(AVFilterLink *inlink, AVFrame *in)
+{
+    AVFilterContext *avctx = inlink->dst;
+    AMFFilterContext *ctx = avctx->priv;
+    AMF_RESULT res;
+    int err;
+
+    if (!ctx->component) {
+        av_frame_free(&in);
+        return AVERROR(EINVAL);
+    }
+    if (!ctx->initialized) {
+        if ((err = vpp_amf_set_input_color(avctx, in)) < 0) {
+            av_frame_free(&in);
+            return err;
+        }
+        res = ctx->component->pVtbl->Init(ctx->component, av_av_to_amf_format(ctx->init_format), inlink->w, inlink->h);
+        if (res != AMF_OK) {
+            av_log(avctx, AV_LOG_ERROR, "AMFConverter-Init() failed with error %d\n", res);
+            av_frame_free(&in);
+            return AVERROR_UNKNOWN;
+        }
+        ctx->initialized = 1;
+    }
+    if (ctx->tonemap != AMF_VIDEO_CONVERTER_TONEMAPPING_UNDEFINED) {
+        av_frame_remove_side_data(in, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+        av_frame_remove_side_data(in, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
+    }
+    return amf_filter_filter_frame(inlink, in);
 }
 
