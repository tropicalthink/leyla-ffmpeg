--- a/libavformat/hlsenc.c
+++ b/libavformat/hlsenc.c
@@ -137,6 +137,7 @@
     int has_subtitle;
     int new_start;
     int start_pts_from_audio;
+    int grid_anchored;    // hls_grid_lead applied to start_pts
     double dpp;           // duration per packet
     int64_t start_pts;
     int64_t end_pts;
@@ -206,6 +207,7 @@
 
     int64_t time;          // Set by a private option.
     int64_t init_time;     // Set by a private option.
+    AVRational grid_lead;  // Set by a private option (Leyla).
     int max_nb_segments;   // Set by a private option.
     int hls_delete_threshold; // Set by a private option.
     uint32_t flags;        // enum HLSFlags
@@ -2474,6 +2476,20 @@
         vs->start_pts_from_audio = 0;
     }
 
+    /* Leyla: a restarted pass keeps an earlier run's cut grid. The grid's
+     * origin lies hls_grid_lead before this pass's first video packet, so
+     * every target is where the earlier run's was, whichever keyframe the
+     * pass starts at. Rounded so the origin is never later than meant: a
+     * keyframe on a target still cuts, one a tick before it does not. */
+    if (vs->has_video && hls->grid_lead.num > 0 && !vs->grid_anchored &&
+        st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO && pkt->pts != AV_NOPTS_VALUE) {
+        vs->start_pts = pkt->pts - av_rescale_rnd(hls->grid_lead.num, st->time_base.den,
+                                                  (int64_t)hls->grid_lead.den * st->time_base.num,
+                                                  AV_ROUND_UP);
+        vs->start_pts_from_audio = 0;
+        vs->grid_anchored = 1;
+    }
+
     if (vs->has_video) {
         can_split = st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO &&
                     ((pkt->flags & AV_PKT_FLAG_KEY) || (hls->flags & HLS_SPLIT_BY_TIME));
@@ -3128,6 +3144,7 @@
     {"start_number",  "set first number in the sequence",        OFFSET(start_sequence),AV_OPT_TYPE_INT64,  {.i64 = 0},     0, INT64_MAX, E},
     {"hls_time",      "set segment length",                      OFFSET(time),          AV_OPT_TYPE_DURATION, {.i64 = 2000000}, 0, INT64_MAX, E},
     {"hls_init_time", "set segment length at init list",         OFFSET(init_time),     AV_OPT_TYPE_DURATION, {.i64 = 0},       0, INT64_MAX, E},
+    {"hls_grid_lead", "the cut grid's origin lies this long before the first video packet", OFFSET(grid_lead), AV_OPT_TYPE_RATIONAL, {.dbl = 0}, 0, INT_MAX, E},
     {"hls_list_size", "set maximum number of playlist entries",  OFFSET(max_nb_segments),    AV_OPT_TYPE_INT,    {.i64 = 5},     0, INT_MAX, E},
     {"hls_delete_threshold", "set number of unreferenced segments to keep before deleting",  OFFSET(hls_delete_threshold),    AV_OPT_TYPE_INT,    {.i64 = 1},     1, INT_MAX, E},
     {"hls_vtt_options","set hls vtt list of options for the container format used for hls", OFFSET(vtt_format_options_str), AV_OPT_TYPE_STRING, {.str = NULL},  0, 0,    E},
